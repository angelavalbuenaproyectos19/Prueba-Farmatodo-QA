{
  "name": "prueba-farmatodo-qa",
  "version": "1.0.0",
  "description": "Playwright (JavaScript) automation framework for wordcounter.net",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:headed": "PW_CHANNEL=chrome playwright test --headed --workers=2",
    "report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": ">=18"
  }
}
